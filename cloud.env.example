# Non-secret configuration. Do not place service-account keys or tokens here.
GOOGLE_CLOUD_PROJECT=spherex-blink
BLINK_GCS_BUCKET=spherex-blink-blink3-products
BLINK_GCS_PREFIX=blink3
BLINK_CORS_ORIGINS=https://iooonut.github.io,https://mateibut.github.io
BLINK_PUBLIC_BASE_URL=
BLINK_SERVE_PIXELS=false
BLINK_WORKFLOW_ENABLED=false
BLINK_FIRESTORE_DATABASE=blink3-state
BLINK_POLICY_FIRESTORE_DATABASE=blink3-policy
BLINK_ORCHESTRATION_URL=
BLINK_TASK_QUEUE=blink3-acquisition
BLINK_TASK_SERVICE_ACCOUNT=blink3-tasks@spherex-blink.iam.gserviceaccount.com
BLINK_REGION=europe-west1
BLINK_PREPARE_JOB=blink3-prepare
BLINK_MAX_ACTIVE_DOWNLOAD_JOBS=3
BLINK_STORE_DIR=backend/data/cloud-store
